# OPTIONAL. Public URL of this app, no trailing slash
# (e.g. https://renzolo-os.vercel.app). Used to build the page Flutterwave
# returns a founder to after paying. If blank, the address the request came
# in on is used, which is what you want on Vercel preview deployments.
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI Diagnostic Report generation)
ANTHROPIC_API_KEY=

# Flutterwave (cards + mobile money across African markets).
# Use the TEST keys from a Flutterwave sandbox until the account is approved.
FLUTTERWAVE_SECRET_KEY=
# Any long random string. Enter the SAME value in the Flutterwave dashboard
# under Settings -> Webhooks, with the webhook URL set to
#   <your site>/api/billing/webhook
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# OPTIONAL. IDs of Payment Plans created in the Flutterwave dashboard, one per
# tier and billing period. Only needed to offer card auto-renewal; leave blank
# and every membership is a one-off payment for one period. Create each plan in
# the main currency at the same amount as its price below.
# FLUTTERWAVE_PLAN_ESSENTIALS_MONTHLY=
# FLUTTERWAVE_PLAN_ESSENTIALS_QUARTERLY=
# FLUTTERWAVE_PLAN_ESSENTIALS_ANNUAL=
# FLUTTERWAVE_PLAN_GROWTH_QUARTERLY=
# FLUTTERWAVE_PLAN_GROWTH_ANNUAL=
# FLUTTERWAVE_PLAN_ELEVATE_QUARTERLY=
# FLUTTERWAVE_PLAN_ELEVATE_ANNUAL=

# Prices (approved Oct 2026). Leave blank for the built-in defaults shown
# here. Changing a price needs a redeploy. See lib/pricing.ts.
# PRICE_CURRENCY=USD
# PRICE_ESSENTIALS_MONTHLY=15
# PRICE_ESSENTIALS_QUARTERLY=45
# PRICE_ESSENTIALS_ANNUAL=150
# PRICE_GROWTH_QUARTERLY=117
# PRICE_GROWTH_ANNUAL=390
# PRICE_ELEVATE_QUARTERLY=447
# PRICE_ELEVATE_ANNUAL=1490
# PRICE_ASSESSMENT=79
# PRICE_COACHING_SINGLE=79
# PRICE_COACHING_SINGLE_MEMBER=59
# PRICE_COACHING_PACK3=199
# PRICE_COACHING_PACK3_MEMBER=149
# Elevate seats (limited by coaching hours: 2 one-on-ones a month each).
# ELEVATE_SEAT_LIMIT=50

# Local-currency prices. NEEDED FOR MOBILE MONEY: Flutterwave only offers
# M-Pesa on Kenyan-shilling charges, and so on per country; a US-dollar
# charge is card / US bank account. Add the currency code to any price
# setting (KES Kenya, ZAR South Africa, NGN Nigeria, GHS Ghana, UGX Uganda,
# RWF Rwanda, TZS Tanzania). Membership is offered in a local currency only
# when ALL seven membership prices are set in it. Nothing is converted
# automatically — choose the amounts.
# PRICE_ESSENTIALS_MONTHLY_KES=
# PRICE_ESSENTIALS_QUARTERLY_KES=
# PRICE_ESSENTIALS_ANNUAL_KES=
# PRICE_GROWTH_QUARTERLY_KES=
# PRICE_GROWTH_ANNUAL_KES=
# PRICE_ELEVATE_QUARTERLY_KES=
# PRICE_ELEVATE_ANNUAL_KES=
# PRICE_ASSESSMENT_KES=
# PRICE_COACHING_SINGLE_KES=
# PRICE_COACHING_PACK3_KES=

# OPTIONAL. Shown to a founder when a payment needs a human to look at it.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Advisor review SLA (hours) — Keep Manual per Phase 1 spec
ADVISOR_REVIEW_SLA_MIN_HOURS=24
ADVISOR_REVIEW_SLA_MAX_HOURS=36
