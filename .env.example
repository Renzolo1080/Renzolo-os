# OPTIONAL. Public URL of this app, no trailing slash
# (e.g. https://renzolo-os.vercel.app). Used to build the page Flutterwave
# returns a founder to after paying. If blank, the address the request came
# in on is used, which is what you want on Vercel preview deployments.
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI Diagnostic Report generation)
ANTHROPIC_API_KEY=

# Flutterwave (cards + mobile money across African markets).
# Use the TEST keys from a Flutterwave sandbox until the account is approved.
FLUTTERWAVE_SECRET_KEY=
# Any long random string. Enter the SAME value in the Flutterwave dashboard
# under Settings -> Webhooks, with the webhook URL set to
#   <your site>/api/billing/webhook
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# OPTIONAL. IDs of Payment Plans created in the Flutterwave dashboard. Only
# needed to offer card auto-renewal; leave blank and every subscription is a
# one-off payment for one period. Create the plans in the main currency and
# at the same amounts as the subscription prices below.
FLUTTERWAVE_MONTHLY_PLAN_ID=
FLUTTERWAVE_ANNUAL_PLAN_ID=

# Prices. Leave blank for the built-in defaults shown here. The $9 / $90
# subscription prices and the $49 non-Africa session price are PLACEHOLDERS,
# not approved launch pricing. Changing a price needs a redeploy.
# SUBSCRIPTION_MONTHLY_PRICE=9
# SUBSCRIPTION_ANNUAL_PRICE=90
# SUBSCRIPTION_CURRENCY=USD
# ADVISOR_SESSION_PRICE_AFRICA=30
# ADVISOR_SESSION_PRICE_OTHER=49
# ADVISOR_SESSION_CURRENCY=USD

# Local-currency prices. NEEDED FOR MOBILE MONEY: Flutterwave only offers
# M-Pesa on Kenyan-shilling charges, and so on per country; a US-dollar
# charge is card / US bank account. Set both subscription prices for a
# currency to offer it to founders in that country (KES Kenya, ZAR South
# Africa, NGN Nigeria, GHS Ghana, UGX Uganda, RWF Rwanda, TZS Tanzania).
# Nothing is converted automatically — choose the amounts.
# SUBSCRIPTION_MONTHLY_PRICE_KES=
# SUBSCRIPTION_ANNUAL_PRICE_KES=
# ADVISOR_SESSION_PRICE_KES=
# SUBSCRIPTION_MONTHLY_PRICE_ZAR=
# SUBSCRIPTION_ANNUAL_PRICE_ZAR=
# ADVISOR_SESSION_PRICE_ZAR=

# OPTIONAL. Shown to a founder when a payment needs a human to look at it.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Advisor review SLA (hours) — Keep Manual per Phase 1 spec
ADVISOR_REVIEW_SLA_MIN_HOURS=24
ADVISOR_REVIEW_SLA_MAX_HOURS=36
