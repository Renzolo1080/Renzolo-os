# Public URL of this app, no trailing slash (e.g. https://renzolo-os.vercel.app).
# Used to build the page Flutterwave returns a founder to after paying.
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI Diagnostic Report generation)
ANTHROPIC_API_KEY=

# Flutterwave (subscription billing — cards + mobile money across African markets)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# IDs of the two Payment Plans created in the Flutterwave dashboard
FLUTTERWAVE_MONTHLY_PLAN_ID=
FLUTTERWAVE_ANNUAL_PLAN_ID=

# Advisor review SLA (hours) — Keep Manual per Phase 1 spec
ADVISOR_REVIEW_SLA_MIN_HOURS=24
ADVISOR_REVIEW_SLA_MAX_HOURS=36
